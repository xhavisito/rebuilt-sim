    "meshoptimizer": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "gltfpack": "1.3.0",
